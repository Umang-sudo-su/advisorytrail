[TEMPLATE]
# The Docker stack no longer reads this file: `docker compose up --build` writes
# the configuration to `.env` at the repository root (see ../../.env.example).
#
# This template is only for running the API directly on the host, outside Docker:
#   cp services/api/.env.example services/api/.env
#   alembic upgrade head
#   uvicorn app.main:app --reload

DATABASE_URL=postgresql+asyncpg://buildshield_user:supersecurepassword@localhost:5433/buildshield_db

# Signing key for API access tokens. Generate one with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Shared secret GitHub sends with webhook deliveries.
GITHUB_WEBHOOK_SECRET=

# Optional personal access token used to read repository manifests.
GITHUB_TOKEN=
