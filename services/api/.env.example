# Copy to .env (same directory) and fill in real values. .env is gitignored; never commit it.
# Generating a GitHub token: Settings -> Developer settings -> Personal access tokens.
# The token only needs read access to repository contents; leave it blank to disable GitHub manifest fetching.

DATABASE_URL=postgresql+asyncpg://buildshield_user:supersecretpassword@db:5432/buildshield_db

# Signing key for API access tokens. Generate one with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Shared secret GitHub sends with webhook deliveries.
GITHUB_WEBHOOK_SECRET=

# Optional fine-grained personal access token used to read repository manifests.
GITHUB_TOKEN=
