# AdvisoryTrail configuration template.
#
# You normally never copy this file: `docker compose up --build` runs the setup
# wizard, which asks for the values below and writes `.env` for you.
#
# To reconfigure an existing installation:
#   docker compose run --rm -e ADVISORYTRAIL_RECONFIGURE=1 setup

# Signing key for API tokens. Generated by the wizard (openssl rand -hex 32).
SECRET_KEY=

# Shared secret GitHub sends with each webhook delivery. Generated by the wizard.
GITHUB_WEBHOOK_SECRET=

# Optional personal access token used to read manifests and set commit statuses.
# Classic scopes: repo + admin:repo_hook (the latter only to create the webhook).
GITHUB_TOKEN=
# Repository the webhook is attached to, as owner/name.
GITHUB_REPOSITORY=

# URL GitHub can reach; localhost works for the dashboard but not for deliveries.
PUBLIC_BASE_URL=http://localhost:8000

# Optional GitHub OAuth app (Settings → GitHub Integration shows a Connect button).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional real email delivery. Leave blank to use the bundled MailHog inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
SMTP_FROM=no-reply@advisorytrail.local

# Ports published on the host.
WEB_PORT=3000
API_PORT=8000
DB_PORT=5433

# Scheduler tick in seconds.
SCHEDULER_TICK_SECONDS=20
